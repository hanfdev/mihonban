# mihonban cloud (Node/VPS runtime) - copy to .env and fill in.
# Add OneDrive, WebDAV, Google Drive, or local-folder credentials from the
# administrator Storage locations page after first sign-in.
APP_PASSWORD=listener-password-for-friends
ADMIN_PASSWORD=your-admin-password
SESSION_SECRET=random-64-hex-chars
# Optional: only required when a local Python companion connects to this runtime.
# COMPANION_KEY=random-48-hex-chars
OD_ROOT=Music/Library
PORT=8788
# Local HTTP only: set this to 1 for http://127.0.0.1; keep unset behind HTTPS.
# DEV_INSECURE_COOKIE=1
# DATA_DIR=./data
# SOURCE_SCAN_HOURS=6
# Optional external audio proxy: set the same random secret on both Workers.
# STREAM_PROXY_SECRET=replace-with-a-long-random-value
