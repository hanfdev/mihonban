// Mihonban Cloudflare Worker configuration.
// The deployment helper (tools/deploy-cloud.cmd) replaces the D1 and KV placeholders.
// Wrangler local development can keep the placeholders and use local emulation.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mihonban",
  "main": "src/index.js",
  "compatibility_date": "2026-06-01",
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mihonban",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  "kv_namespaces": [
    { "binding": "KV", "id": "00000000000000000000000000000000" }
  ],
  "triggers": {
    // Scan source feeds every six hours (UTC); this never downloads music.
    "crons": ["17 */6 * * *"]
  },
  "vars": {
    // Shared library-relative root for named storage; credentials live in storages.
    "OD_ROOT": "Music/Library",
    // Stable key prevents the compatibility migration from running per request.
    "DB_SCHEMA_KEY": "mihonban"
  }
  // Secrets (wrangler secret put ...):
  //   APP_PASSWORD    Initial listener password
  //   ADMIN_PASSWORD  Initial administrator password
  //   SESSION_SECRET  Session signing key (at least 32 random bytes)
  //   COMPANION_KEY   API key for the optional local companion
  //   STREAM_PROXY_SECRET  Optional; must match the proxy Worker's PROXY_SECRET
}
