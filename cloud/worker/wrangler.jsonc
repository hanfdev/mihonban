// mihonban cloud — Cloudflare Worker 配置
// 部署向导 (tools/deploy-cloud.cmd) 会把 database_id / kv id 替换成真实值。
// 本地开发 (wrangler dev) 用占位符即可，D1/KV 走本地模拟。
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mihonban",
  "main": "src/index.js",
  "compatibility_date": "2026-06-01",
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mihonban",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  "kv_namespaces": [
    { "binding": "KV", "id": "00000000000000000000000000000000" }
  ],
  "triggers": {
    // 每 6 小时扫一次资源站新帖（UTC；只读 feed，不下载文件）
    "crons": ["17 */6 * * *"]
  },
  "vars": {
    // 所有命名存储共用的曲库相对根目录；凭据保存在 storages 表中。
    "OD_ROOT": "Music/Library"
  }
  // Secrets (wrangler secret put …)：
  //   APP_PASSWORD    听众初始口令
  //   ADMIN_PASSWORD  管理员初始口令
  //   SESSION_SECRET  会话签名密钥（随机 32+ 字节）
  //   COMPANION_KEY   本地伴侣程序的 API key
  //   STREAM_PROXY_SECRET  可选；与独立代理 Worker 的 PROXY_SECRET 相同
}
